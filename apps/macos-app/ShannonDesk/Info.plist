<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>シャノン</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>シャノン</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>アプリを開いて話している間に、見てと言われた時や話の流れで気になった時に、シャノンが1枚だけ見るためにカメラを使用します。見た時は「いま見ました」と表示し、見た1枚は保存しません。設定でオフにできます。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>設定で「イヤホンのときは声で話しかける」をオンにしている間、シャノンがイヤホンで話しかけたあとの数秒だけ、返事を聞き取るためにマイクを使用します。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>設定で「カレンダーの予定をシャノンに伝える」をオンにしている間、これから14日ぶんの予定の題名・時刻・場所・カレンダー名を読み取り、シャノンが予定を知って声をかけたり答えたりできるようにサーバーへ送ります。</string>
	<key>ShannonAPIBaseURL</key>
	<string>$(SHANNON_API_BASE_URL)</string>
	<key>ShannonAPIToken</key>
	<string>$(SHANNON_API_TOKEN)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.r41r41.shannon.macos.connect</string>
			<key>CFBundleURLSchemes</key>
			<array><string>shannon</string></array>
		</dict>
	</array>
</dict>
</plist>

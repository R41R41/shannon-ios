<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Shannon</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
        </dict>
        <key>CFBundleAlternateIcons</key>
        <dict>
            <key>ShannonIconCalm</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconCalm</string></array></dict>
            <key>ShannonIconJoyful</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconJoyful</string></array></dict>
            <key>ShannonIconCurious</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconCurious</string></array></dict>
            <key>ShannonIconSleepy</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconSleepy</string></array></dict>
            <key>ShannonIconExasperated</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconExasperated</string></array></dict>
            <key>ShannonIconExcited</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconExcited</string></array></dict>
            <key>ShannonIconLaughing</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconLaughing</string></array></dict>
            <key>ShannonIconTender</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconTender</string></array></dict>
            <key>ShannonIconBashful</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconBashful</string></array></dict>
            <key>ShannonIconDetermined</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconDetermined</string></array></dict>
            <key>ShannonIconSleeping</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonIconSleeping</string></array></dict>
        </dict>
    </dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>com.r41r41.shannon.connect</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>shannon</string>
            </array>
        </dict>
    </array>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>開発中のシャノンAPIへ接続するため、同じネットワーク上のMacを検出します。</string>
    <key>ShannonAPIBaseURL</key>
    <string>$(SHANNON_API_BASE_URL)</string>
    <key>ShannonAPIToken</key>
    <string>$(SHANNON_API_TOKEN)</string>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>あなたが撮った写真を会話へ共有する時と、アプリを開いて話している間に見てと言われた時や話の流れで気になった時にシャノンが1枚だけ見る時に、カメラを使用します。シャノンが見た時は「いま見ました」と表示し、見た1枚は保存しません。設定でオフにできます。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>シャノンとの音声会話中は、ほかのアプリを使用している間もマイクを使用します。音声会話画面からいつでも終了できます。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>設定で「カレンダーの予定をシャノンに伝える」をオンにしている間、これから14日ぶんの予定の題名・時刻・場所・カレンダー名を読み取り、シャノンが予定を知って声をかけたり答えたりできるようにサーバーへ送ります。会話で頼んだ時は、シャノンがカレンダーに予定を追加します。</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>会話で「予定を入れて」と頼んだ時に、シャノンがカレンダーに予定を追加します。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>会話で「リマインドして」と頼んだ時に、シャノンがリマインダーに通知つきの項目を追加します。</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>会話で頼んだ時や、シャノンの提案にあなたが応じた時に、Apple Musicの曲を探してこのアプリで再生します。曲を選ぶために、最近聴いた曲・よく聴く曲・ライブラリのプレイリストを読みます。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>現在地に関する質問をしたときだけ、近くの場所や交通を調べるために位置情報を使用します。</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>シャノン</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>ShannonL06</string>
        </dict>
        <key>CFBundleAlternateIcons</key>
        <dict>
            <key>ShannonL02</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonL02</string></array></dict>
            <key>ShannonL10</key>
            <dict><key>CFBundleIconFiles</key><array><string>ShannonL10</string></array></dict>
        </dict>
    </dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>com.r41r41.shannon.connect</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>shannon</string>
            </array>
        </dict>
    </array>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>開発中のシャノンAPIへ接続するため、同じネットワーク上のMacを検出します。</string>
    <key>ShannonAPIBaseURL</key>
    <string>$(SHANNON_API_BASE_URL)</string>
    <key>ShannonAPIToken</key>
    <string>$(SHANNON_API_TOKEN)</string>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>

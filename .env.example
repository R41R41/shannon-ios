# OpenAI Responses API. Keep the real value only in .env or your shell.
OPENAI_API_KEY=

# Development-only Gemini TTS listening lab. Never expose this key to an Apple client.
GEMINI_API_KEY=

# Fixed v1 conversation model. Default: gpt-5.6-luna
SHANNON_LLM_MODEL=gpt-5.6-luna

# Separate nightly analysis model. Defaults to SHANNON_LLM_MODEL.
SHANNON_SLEEP_MODEL=gpt-5.6-luna
SHANNON_SLEEP_TIMEZONE=Asia/Tokyo
SHANNON_SLEEP_HOUR=3
SHANNON_SLEEP_MIN_MESSAGES=3

# Background-only hard budget. Chat is never blocked by this breaker.
SHANNON_BACKGROUND_LLM_MONTHLY_BUDGET_USD=0.5
# Optional conservative price overrides for an unknown/custom model.
SHANNON_LLM_INPUT_USD_PER_MILLION=
SHANNON_LLM_OUTPUT_USD_PER_MILLION=

# Realtime voice. Production may keep `live` until an intentional rollout;
# the Realtime path is tool-capable and defaults to the exact gpt-realtime-2 model.
SHANNON_VOICE_ENGINE=live
SHANNON_VOICE_REALTIME_MODEL=gpt-realtime-2
SHANNON_VOICE_REALTIME_REASONING_EFFORT=low
SHANNON_VOICE_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
SHANNON_VOICE_REALTIME_VOICE=marin
SHANNON_VOICE_LIVE_MODEL=gpt-live-1

# Durable conversation, shared state, and append-only experience log.
# Default: <repository>/data/shannon.sqlite
SHANNON_DATABASE_PATH=

# Read-only bridge written by Aether after the owner enables sharing.
# Both services should point at the same owner-only 0600 JSON file.
SHANNON_AETHER_CONTEXT_FILE=
# Pending proposal files consumed by Aether. No note is edited here.
SHANNON_AETHER_PROPOSAL_DIR=

# Local development server. Use `lan` only for physical-iPhone development.
SHANNON_API_HOST=127.0.0.1
SHANNON_API_PORT=4317
# Required for `SHANNON_API_HOST=lan`; use at least 32 random characters.
SHANNON_API_TOKEN=
# Separate bearer token used only by the outbound Mac Agent Host.
SHANNON_AGENT_HOST_TOKEN=
# Agent Host runs on the Mac and accepts only these pre-registered project names.
# Example: {"shannon-ios":"/Users/you/Projects/shannon-ios"}
SHANNON_AGENT_PROJECTS_JSON=
SHANNON_AGENT_DEFAULT_PROJECT=
SHANNON_AGENT_HOST_ID=shannon-mac
SHANNON_AGENT_HOST_NAME=Shannon Mac
# Optional. The ChatGPT-bundled Codex is auto-detected on macOS when this is empty.
SHANNON_CODEX_COMMAND=
SHANNON_CODEX_MODEL=
SHANNON_CODEX_REASONING_EFFORT=high
SHANNON_AGENT_STATE_FILE=

# Production/Azure authentication. The API stays on 127.0.0.1 behind HTTPS nginx.
# `paired` enables single-use codes and per-device tokens; never commit the pepper.
SHANNON_AUTH_MODE=fixed
SHANNON_AUTH_PEPPER=
SHANNON_OWNER_SCOPE_KEY=owner

# Optional APNs token-based delivery. Keep the .p8 key outside this repository.
# The world worker stays fully functional with these values unset.
SHANNON_APNS_KEY_ID=
SHANNON_APNS_TEAM_ID=
SHANNON_APNS_BUNDLE_ID=com.r41r41.shannon
SHANNON_APNS_PRIVATE_KEY_FILE=

      },
      "page": {
        "seconds": 0.34,
        "meaning": "画面の切り替え"
      },
      "emphasized": {
        "seconds": 0.35,
        "meaning": "開く・たたむ（弾まないばね）"
      },
      "holdToConfirm": {
        "seconds": 0.6,
        "meaning": "長押しで決める操作が決まるまで"
      }
    },
    "rules": [
      "視差効果を減らす設定では、位置が動く演出と繰り返す演出をやめる。",
      "跳ねない（bounce 0）。進んだことを祝う拡大や点滅はしない。"
    ]
  },
  "decisions": [
    {
      "date": "2026-10-03",
      "what": "色の役割",
      "decision": "iPhone の役割分け（押せるもの = 青、シャノンがいること = 藍、うまくいった・動いている = 緑、あなたの判断が要る = 橙、危ない = 赤）を、iOS・macOS・Windows の 3 つで同じ値にする。Mac は OS の強調色をやめ、Windows は 1 つの青を 4 つの役割に分ける。"
    },
    {
      "date": "2026-10-03",
      "what": "広い画面の文字の大きさ",
      "decision": "Mac と Windows は本文 15（typography.desktop）。iPhone は Dynamic Type のまま（typography.scale）。行の高さの目安は 40（size.desktopRowHeight）。"
    },
    {
      "date": "2026-10-03",
      "what": "承認の操作",
      "decision": "長く効く許可は、3 つの画面とも長押し（motion.duration.holdToConfirm）で決める。キーボードや支援技術では、同じ文の確認で決める。"
    }
  ]

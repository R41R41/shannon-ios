    "duration": {
      "quick": { "seconds": 0.15, "meaning": "押した手応え、視差効果を減らす設定のときの切り替え（ease-out）" },
      "standard": { "seconds": 0.22, "meaning": "お知らせや帯が出入りする（ease-out）" },
      "page": { "seconds": 0.34, "meaning": "画面の切り替え" },
      "emphasized": { "seconds": 0.35, "meaning": "開く・たたむ（弾まないばね）" },
      "holdToConfirm": { "seconds": 0.6, "meaning": "長押しで決める操作が決まるまで" }
    },
    "rules": [
      "視差効果を減らす設定では、位置が動く演出と繰り返す演出をやめる。",
      "跳ねない（bounce 0）。進んだことを祝う拡大や点滅はしない。"
    ]

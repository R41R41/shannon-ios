# Shannon API on Azure. Non-local connections must use HTTPS.
SHANNON_API_BASE_URL=https://sh4nnon.com/companion
SHANNON_AGENT_HOST_TOKEN=

# Only aliases in this map can become Codex working directories.
SHANNON_AGENT_PROJECTS_JSON={"shannon-ios":"/Users/you/Projects/shannon-ios"}
SHANNON_AGENT_DEFAULT_PROJECT=shannon-ios
SHANNON_AGENT_HOST_ID=shannon-mac
SHANNON_AGENT_HOST_NAME=Shannon Mac
SHANNON_AGENT_DELIVERY_MODE=local-device

# Optional Codex overrides.
SHANNON_CODEX_COMMAND=/Applications/ChatGPT.app/Contents/Resources/codex
SHANNON_CODEX_MODEL=
SHANNON_CODEX_REASONING_EFFORT=high
SHANNON_AGENT_STATE_FILE=/Users/you/Library/Application Support/Shannon/agent-host-state.json

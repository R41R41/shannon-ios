[Unit]
Description=Shannon cloud Agent Host
After=network-online.target shannon-ios.service
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/shannon-ios
EnvironmentFile=/home/azureuser/.config/shannon-agent-host/agent-host.env
Environment=HOME=/home/azureuser
Environment=CODEX_HOME=/home/azureuser/shannon-agent-data/codex
Environment=SHANNON_AGENT_WORKSPACE_ROOT=/home/azureuser/shannon-agent-workspace
Environment=PATH=/home/azureuser/shannon-agent-runtime/bin:/home/azureuser/shannon-ios-runtime/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/azureuser/shannon-ios-runtime/bin/node --import tsx services/api/src/agentHost.ts
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The operator socket (docs/operator-minecraft-contract.md) is the API's alone: ProtectHome=read-only does not stop an AF_UNIX connect.
InaccessiblePaths=/home/azureuser/shannon-ios-data/operator-runtime
ReadWritePaths=/home/azureuser/shannon-agent-workspace /home/azureuser/shannon-agent-data

[Install]
WantedBy=multi-user.target

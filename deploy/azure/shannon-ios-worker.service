[Unit]
Description=Shannon iOS background cognition and sleep worker
After=network-online.target shannon-ios.service
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/shannon-ios
Environment=NODE_ENV=production
Environment=SHANNON_DATABASE_PATH=/home/azureuser/shannon-ios-data/shannon.sqlite
Environment=SHANNON_SLEEP_TIMEZONE=Asia/Tokyo
Environment=SHANNON_SLEEP_HOUR=3
Environment=SHANNON_BACKGROUND_LLM_MONTHLY_BUDGET_USD=0.5
EnvironmentFile=/home/azureuser/.config/shannon-ios/api.env
ExecStart=/home/azureuser/shannon-ios-runtime/bin/node --import tsx services/api/src/worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# The operator socket (docs/operator-minecraft-contract.md) is the API's alone: ProtectHome=read-only does not stop an AF_UNIX connect.
InaccessiblePaths=/home/azureuser/shannon-ios-data/operator-runtime
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/home/azureuser/shannon-ios-data

[Install]
WantedBy=multi-user.target

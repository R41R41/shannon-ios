# Keep this file at /home/azureuser/.config/shannon-agent-host/agent-host.env (0600).
# Values shown here are placeholders; never commit real tokens or API keys.
SHANNON_API_BASE_URL=https://sh4nnon.com/companion
SHANNON_AGENT_HOST_TOKEN=

# This is a dedicated writable checkout, separate from the running API deployment.
SHANNON_AGENT_PROJECTS_JSON={"shannon-ios":"/home/azureuser/shannon-agent-workspace/shannon-ios"}
SHANNON_AGENT_DEFAULT_PROJECT=shannon-ios
SHANNON_AGENT_HOST_ID=shannon-cloud
SHANNON_AGENT_HOST_NAME=Shannon Cloud
SHANNON_AGENT_STATE_FILE=/home/azureuser/shannon-agent-data/agent-host-state.json
SHANNON_AGENT_DELIVERY_MODE=cloud-testflight

# Install Codex outside the production application directory.
SHANNON_CODEX_COMMAND=/home/azureuser/shannon-agent-runtime/bin/codex
SHANNON_CODEX_MODEL=
SHANNON_CODEX_REASONING_EFFORT=high

# Codex must be authenticated separately for this host. Prefer a dedicated,
# revocable project/service-account API key rather than copying a personal login.
OPENAI_API_KEY=

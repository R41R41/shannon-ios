# Install as /home/azureuser/.config/shannon-ios/api.env with mode 0600.
# Never place the real file inside the repository.
OPENAI_API_KEY=
SHANNON_LLM_MODEL=gpt-5.6-luna
# Leave unset until Shannon Cloud is online and verified. Then use shannon-cloud.
SHANNON_AGENT_DEFAULT_HOST=shannon-mac
SHANNON_SLEEP_MODEL=gpt-5.6-luna
SHANNON_BACKGROUND_LLM_MONTHLY_BUDGET_USD=0.5
SHANNON_VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
SHANNON_VOICE_USD_PER_MINUTE=0.0045
SHANNON_VOICE_DAILY_BUDGET_USD=0.10
# Realtime voice starts only from an explicit user action. Keep these model names
# configurable so rollout can fall back without rebuilding the iOS app.
# Start with realtime in production. Switch to live only after the matching iOS
# candidate passes the physical-device travel smoke tests.
SHANNON_VOICE_ENGINE=realtime
SHANNON_VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini
SHANNON_VOICE_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
SHANNON_VOICE_REALTIME_VOICE=marin
SHANNON_VOICE_REALTIME_TIMEOUT_MS=30000
SHANNON_VOICE_REALTIME_DAILY_MINUTES=60
SHANNON_VOICE_LIVE_MODEL=gpt-live-1
SHANNON_VOICE_LIVE_VOICE=marin
SHANNON_VOICE_LIVE_TIMEOUT_MS=30000
# One explicit camera snapshot at a time; images are sent with store=false.
SHANNON_VISION_MODEL=gpt-5.6-luna
SHANNON_VISION_TIMEOUT_MS=30000
# Voice Identity previews use the same server-side OpenAI key and a fixed phrase.
SHANNON_VOICE_PREVIEW_MODEL=gpt-4o-mini-tts
SHANNON_VOICE_PREVIEW_TIMEOUT_MS=30000
SHANNON_AUTH_PEPPER=
SHANNON_OWNER_SCOPE_KEY=owner
SHANNON_AUTH_MODE=paired
SHANNON_AGENT_HOST_TOKEN=
# Optional cross-platform memory bridge. Keep all three values empty until the
# legacy platform runtime has its own revocable service token and exact owner
# bindings. The caller never supplies the Shannon scope key.
SHANNON_PLATFORM_BRIDGE_TOKEN=
SHANNON_PLATFORM_BRIDGE_SCOPE_KEY=owner
# Example shape only; use real opaque IDs solely in the ignored production env:
# [{"platform":"discord","conversationId":"...","ownerUserId":"...","title":"Discord・友人グループ"}]
SHANNON_PLATFORM_BRIDGE_BINDINGS_JSON=
SHANNON_DATABASE_PATH=/home/azureuser/shannon-ios-data/shannon.sqlite
SHANNON_AETHER_CONTEXT_FILE=/home/azureuser/.local/share/aether/shannon-context.json
SHANNON_AETHER_PROPOSAL_DIR=/home/azureuser/.local/share/aether/proposals
# Phase 1: leave all three empty until a dedicated Voyager destination is issued.
# Partial configuration fails closed; never reuse an iPhone/device credential here.
SHANNON_VOYAGER_INTEGRATION_URL=
SHANNON_VOYAGER_INTEGRATION_TOKEN=
SHANNON_VOYAGER_WORKSPACE_ID=
# Optional; falls back to SHANNON_LLM_MODEL.
SHANNON_ORGANIZE_MODEL=
SHANNON_APNS_KEY_ID=
SHANNON_APNS_TEAM_ID=
SHANNON_APNS_BUNDLE_ID=com.r41r41.shannon
SHANNON_APNS_PRIVATE_KEY_FILE=/home/azureuser/.config/shannon-ios/AuthKey_Shannon.p8

# Haiku 5.5: official Anthropic Messages API; mandatory 1h cache with measured creation/read usage.
# Haiku-only conversation/background credential; does not enable existing Sonnet hooks.
# Own-time still requires its explicit credential setting below; Anthropic same-value sharing is owner opt-in only.
SHANNON_HAIKU_API_KEY=
# Optional shared Sonnet credential; also a backward-compatible Haiku fallback.
SHANNON_ANTHROPIC_API_KEY=

# Install as /home/azureuser/.config/shannon-ios/api.env with mode 0600.
# Never place the real file inside the repository.
OPENAI_API_KEY=
SHANNON_LLM_MODEL=claude-haiku-5-5
# Optional TypeSafe Jev voice router. Keep the real key only in this mode-0600 file.
# Until waitlist access is granted, the lightweight Haiku router is selected.
TYPESAFE_API_KEY=
SHANNON_JEV_MODEL=jev-latest
SHANNON_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
SHANNON_JEV_TIMEOUT_MS=900
SHANNON_VOICE_ROUTER_MODEL=claude-haiku-5-5
SHANNON_VOICE_ROUTER_TIMEOUT_MS=1200
SHANNON_VOICE_SKILL_THRESHOLD=0.55
# Leave unset until Shannon Cloud is online and verified. Then use shannon-cloud.
SHANNON_AGENT_DEFAULT_HOST=shannon-mac
SHANNON_SLEEP_MODEL=claude-haiku-5-5
SHANNON_BACKGROUND_LLM_MONTHLY_BUDGET_USD=0.5
# Conversation replay window: characters of thread history replayed to the reply model (2000..60000 each).
# Unset, 12000; the text budget is 32000 when unset under SHANNON_REPLAY_EPOCHS (set it to 32000 here when turning them on).
# The worker reads this file too and must see the same values.
SHANNON_CONVERSATION_REPLAY_CHARACTERS=12000
SHANNON_VOICE_REPLAY_CHARACTERS=12000
SHANNON_CONVERSATION_SUMMARY_MODEL=claude-haiku-5-5
# Her impressions of people (docs/architecture.md): "off" reads none into a prompt and updates none; the API and the
# worker must see the same value. One background call per owner turn, capped per day and by a share of the budget above.
SHANNON_IMPRESSIONS=on
SHANNON_IMPRESSIONS_MODEL=claude-haiku-5-5
SHANNON_IMPRESSIONS_MAX_CALLS_PER_DAY=20
SHANNON_IMPRESSIONS_BUDGET_FRACTION=0.8
SHANNON_IMPRESSIONS_PROMPT_LINES=4
SHANNON_IMPRESSIONS_VOICE_LINES=2
# Bounded autonomy (Syzygy ADR-0002). Off until the owner enables the activity loop.
# These values are core: Shannon cannot change them through the autonomy service.
# SHANNON_AUTONOMY_ENABLED (false until he enables it) is in the generated switch section at the end of this file.
# Hard daily cap for her own model/API use, per owner-local day, and the conversion used to count it.
SHANNON_AUTONOMY_DAILY_BUDGET_YEN=2000
SHANNON_AUTONOMY_YEN_PER_USD=160
SHANNON_AUTONOMY_TIMEZONE=Asia/Tokyo
# The owner's home area for weather.forecast, route.estimate and the morning brief (Open-Meteo, no key): lat,lon,label.
# Unset: a weather call without a place asks where, and SHANNON_MORNING_BRIEF hands in nothing.
# It is also web.search's locality=home (approximate user_location: the label as city, or prefecture+city like 東京都西東京市).
# SHANNON_OWNER_HOME_LOCATION=35.7255,139.5383,西東京市
# The region (prefecture) of the home for web search when the label does not name it.
# SHANNON_OWNER_HOME_REGION=東京都
# Largest increase the owner can approve for one day.
SHANNON_AUTONOMY_MAX_EXTRA_YEN=3000
SHANNON_AUTONOMY_MAX_PUBLIC_READS=200
# Reads of the owner's shared Notion pages by her own activity, per owner-local day.
SHANNON_AUTONOMY_MAX_NOTION_READS=100
# Looks at the room she takes in her own activity (docs/body-contract.md, "A look in her own time"). No count a day
# (owner decision 2026-10-03): empty or "unlimited". A number sets one. Counted inside SHANNON_BODY_LOOK_PER_HOUR,
# charged to the daily budget, seen with SHANNON_AUTONOMY_GEMINI_API_KEY.
# 0 switches them off and leaves looks in conversation as they are; SHANNON_BODY_LOOK=off stops both. Set it for the API and the autonomy service alike.
SHANNON_AUTONOMY_MAX_ROOM_LOOKS=unlimited
# A message of her own to the owner (話しかける), from her own activity. No count a day (owner decision 2026-10-03: within the
# cost budget, as many as she likes): "unlimited" or unset is no count, a positive number is that many per owner-local day, 0
# switches it off (her messages; a call to his iPhone is switched by SHANNON_INCOMING_CALLS and his own switch in the app).
# SPACING_MINUTES is the shortest time between two messages (default 5), so a loop cannot flood him.
# Not while a conversation is in progress; no quiet hours (owner decision 2026-10-02). Charged to the daily budget.
SHANNON_AUTONOMY_MAX_REACH_OUTS=unlimited
SHANNON_AUTONOMY_REACH_OUT_SPACING_MINUTES=5
# Act, observe, think again (owner decision 2026-10-02). After a message of hers she waits this long for an answer (0-300 seconds),
# then may think again and call once more: at most one per message; "unlimited" or unset is no count per owner-local day, a positive number is that many.
# MAX_FOLLOW_UPS=0 switches the whole mechanism off (no wait, no observation, no second thought; prompts as before).
# CYCLE_MAX_RETHINKS (0-3) is how many times a cycle may think again after a step that did not go as planned; each is one of the cycle's steps.
# Set them for the API and the autonomy service alike.
SHANNON_AUTONOMY_MAX_FOLLOW_UPS=unlimited
SHANNON_AUTONOMY_REACH_OUT_WAIT_SECONDS=180
SHANNON_AUTONOMY_CYCLE_MAX_RETHINKS=2
# Activity loop (ADR-0002 step 3): `shannon-ios-autonomy.service`. It stays idle unless SHANNON_AUTONOMY_ENABLED=true,
# the owner has not paused her in the app, and an explicit own-time credential below is set.
# Explicit keys for her own activity, with a spending cap set at the provider. Never reuse OPENAI_API_KEY or
# GEMINI_API_KEY here: a value equal to the conversation key is treated as not configured. A Gemini key alone is enough.
SHANNON_AUTONOMY_GEMINI_API_KEY=
SHANNON_AUTONOMY_OPENAI_API_KEY=
# Anthropic always needs this explicit setting; no regular-key fallback. By default its value must differ from
# SHANNON_HAIKU_API_KEY, SHANNON_ANTHROPIC_API_KEY and ANTHROPIC_API_KEY. Only owner-approved sharing permits equality.
SHANNON_AUTONOMY_ANTHROPIC_API_KEY=
# Set exactly on only with owner approval to allow the explicit Anthropic value to match a regular key.
# A shared provider cap is not an own-time-only limit; application budgets/stop/unknown/cache gates remain.
SHANNON_AUTONOMY_ANTHROPIC_SHARED_KEY=off
# How her day is paced (owner decision 2026-10-02, Syzygy ADR-0003). `sessions` (default): she runs until she decides to rest
# and says when she comes back, inside the bounds below. `cycles`: the fixed cycles of the cadence further down, exactly as
# before sessions existed. Any other value than `sessions` counts as `cycles`. Set it for the API (which shows her session
# to the owner) and the autonomy service alike. It does not switch the owner's context off: that is its own switch below.
SHANNON_AUTONOMY_PACING=sessions
# One session: what it may spend in yen (estimates included), how many minutes it may run (not counting the time it stood
# still for the owner), and its steps (the hard stop if she never rests). One day: how many sessions she may begin.
# The day's cap stays SHANNON_AUTONOMY_DAILY_BUDGET_YEN, checked by the gate before every paid step.
SHANNON_AUTONOMY_SESSION_MAX_YEN=400
SHANNON_AUTONOMY_SESSION_MAX_MINUTES=40
SHANNON_AUTONOMY_SESSION_MAX_STEPS=40
SHANNON_AUTONOMY_SESSIONS_PER_DAY=12
# Her rest between two sessions, in minutes: the shortest and the longest she may choose, and the one taken when she
# names none or a bound stopped her.
SHANNON_AUTONOMY_SESSION_MIN_REST_MINUTES=10
SHANNON_AUTONOMY_SESSION_MAX_REST_MINUTES=720
SHANNON_AUTONOMY_SESSION_DEFAULT_REST_MINUTES=150
# The rest after a session that did nothing but think and found no step (she comes back sooner than the default).
SHANNON_AUTONOMY_SESSION_NO_PLAN_REST_MINUTES=30
# Output ceiling of a thinking step in a session (1500-8000). The model's own reasoning counts against it: at 1,500 a
# Gemini reply was cut off in the middle of its JSON. The gate reserves room for the whole ceiling; she is charged what is used.
SHANNON_AUTONOMY_SESSION_THINK_OUTPUT_TOKENS=4000
# `low` (default): a thinking step asks the provider to spend little of that ceiling on its own reasoning
# (OpenAI `reasoning.effort`, Gemini `thinkingConfig.thinkingLevel`). A provider that refuses the field is asked once more
# without it and, when that works, not sent it again until the service restarts. Any other value: the field is never sent.
SHANNON_AUTONOMY_PLAN_REASONING=low
# What her own activity may see of the owner's (owner decision 2026-10-02, Syzygy ADR-0003): one bounded block in her
# thinking prompt (and half of it, without his secrets, in a story, a note or a message of hers), read through the
# conversation's memory entry points. With it she may write about him and the people he knows.
# `off` opens none of it and every prompt is what it was. CHARACTERS (400-8000) is the size of the block.
SHANNON_AUTONOMY_OWNER_CONTEXT=on
SHANNON_AUTONOMY_OWNER_CONTEXT_CHARACTERS=2400
# Her own time may search and read the owner's Aether documents (outside her folder) for one of her active pursuits
# (owner decision 2026-10-06, Syzygy ADR-0007; tools ownerDocs.search / ownerDocs.read, Aether must be configured). What she
# writes after that is marked and not read with anyone else present. `on` only; unset, `off` or anything else: off.
SHANNON_AUTONOMY_OWNER_DOCUMENTS=off
# Cadence under SHANNON_AUTONOMY_PACING=cycles: cycles per owner-local day, minutes between cycle starts (default: 24 h / cycles),
# steps and reads per cycle. In sessions, CYCLE_MAX_STEPS less one is the length of one plan and CYCLE_MAX_READS the reads of one plan.
SHANNON_AUTONOMY_CYCLES_PER_DAY=4
SHANNON_AUTONOMY_CYCLE_INTERVAL_MINUTES=
SHANNON_AUTONOMY_CYCLE_MAX_STEPS=6
SHANNON_AUTONOMY_CYCLE_MAX_READS=2
# A cycle or a session does not start, and a session stands still, while the owner wrote or spoke this recently.
SHANNON_AUTONOMY_OWNER_ACTIVE_MINUTES=10
SHANNON_AUTONOMY_POLL_SECONDS=60
# Public reading: bytes and milliseconds per page. The per-day count is SHANNON_AUTONOMY_MAX_PUBLIC_READS above.
SHANNON_AUTONOMY_READ_MAX_BYTES=1500000
SHANNON_AUTONOMY_READ_TIMEOUT_MS=10000
# Places to start reading from, e.g. [{"title":"<name>","url":"https://<public page>"}]. Empty uses the built-in list.
SHANNON_AUTONOMY_READING_SEEDS_JSON=
# What she asks for when the day's cap stops a step she cares about (once a day; the owner decides).
SHANNON_AUTONOMY_BUDGET_REQUEST_YEN=300
# USD per million tokens for models whose price is not in the code, e.g. {"gemini-3.8-flash":{"input":<usd>,"output":<usd>}}.
# Unset models are charged at a deliberately high fail-safe rate.
SHANNON_AUTONOMY_MODEL_PRICES_JSON=
# Her places. The workspace must be apart from the deployed source.
SHANNON_AUTONOMY_WORKSPACE_ROOT=
# Her folder on the owner's machines (docs/host-folder-contract.md), e.g. {"owner-windows":{"deviceId":"<16 hex id of the paired device>"}}.
# Only that device may claim work for the host. The earlier shape {"<host>":"<absolute folder>"} is still read. Empty registers no host.
SHANNON_AUTONOMY_HOST_FOLDERS_JSON=
# Copies she may queue for her folders per owner-local day (0 switches the step off), and how long a device may hold one.
SHANNON_AUTONOMY_MAX_HOST_FOLDER_WRITES=10
SHANNON_AUTONOMY_HOST_STEP_LEASE_SECONDS=300
# Extra roots, separated by the platform path delimiter. The running source and the database directory are always protected.
SHANNON_AUTONOMY_REPOSITORY_ROOTS=
SHANNON_AUTONOMY_PRODUCTION_ROOTS=
SHANNON_AUTONOMY_PROTECTED_PATHS=
# Memory V2 semantic recall (OpenAI; response-path lane `memory`, background lane `memory_background`)
SHANNON_MEMORY_SEMANTIC_ENABLED=true
SHANNON_MEMORY_MAX_MODEL_CALLS_PER_TURN=4
SHANNON_MEMORY_SEMANTIC_TIMEOUT_MS=4000
SHANNON_MEMORY_SEMANTIC_SCAN_LIMIT=5000
SHANNON_MEMORY_MODEL=claude-haiku-5-5
SHANNON_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
SHANNON_MEMORY_EMBEDDING_DIMENSIONS=512
SHANNON_MEMORY_EMBEDDING_INTERVAL_MS=30000
# Shannon private knowledge building after each sleep batch (background budget)
SHANNON_KNOWLEDGE_ENABLED=true
SHANNON_KNOWLEDGE_MODEL=gpt-5.6-terra
SHANNON_VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
SHANNON_VOICE_USD_PER_MINUTE=0.0045
SHANNON_VOICE_DAILY_BUDGET_USD=0.10
# Voice calls transcribe through OpenAI Realtime. Azure mints a short-lived client
# secret from OPENAI_API_KEY; the permanent key is never returned to an Apple client.
# Optional overrides (defaults shown). The per-minute estimate is not provider-verified.
# SHANNON_VOICE_CALL_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Turn detection of OpenAI transcription sessions: semantic_vad for the client platforms listed (named at mint), server_vad
# (650 ms of silence by default) for every other client; TURN_DETECTION=server turns semantic detection off for all.
# SHANNON_VOICE_CALL_SEMANTIC_PLATFORMS=windows
# SHANNON_VOICE_CALL_TURN_DETECTION=semantic
# SHANNON_VOICE_CALL_VAD_EAGERNESS=medium
# SHANNON_VOICE_CALL_SILENCE_MS=650
# SHANNON_VOICE_CALL_SECRET_SECONDS=300
# SHANNON_VOICE_CALL_USD_PER_MINUTE=0.003
# Gemini now supplies only response speech (TTS). The key stays on Azure and is never
# returned to an Apple client. Flash-Lite pricing below is valid through
# 2026-12-31; update the estimate when provider pricing changes.
GEMINI_API_KEY=
SHANNON_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
SHANNON_GEMINI_TTS_VOICE=Leda
SHANNON_GEMINI_TTS_STYLE=warm, naturally cute, intimate, and conversational Japanese without sounding childish or theatrical
SHANNON_GEMINI_TTS_TIMEOUT_MS=60000
SHANNON_GEMINI_TTS_OUTPUT_USD_PER_10_SECONDS=0.0015
# One-use transcription tokens are minted here; the permanent key is never sent to iPhone.
SHANNON_GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
SHANNON_GEMINI_LIVE_SESSION_MINUTES=20
SHANNON_GEMINI_LIVE_INPUT_USD_PER_MINUTE=0.005
SHANNON_GEMINI_LIVE_OUTPUT_USD_PER_MINUTE=0.018
# One explicit camera snapshot at a time; images are sent with store=false.
SHANNON_VISION_MODEL=claude-haiku-5-5
SHANNON_VISION_TIMEOUT_MS=30000
SHANNON_AUTH_PEPPER=
SHANNON_OWNER_SCOPE_KEY=owner
SHANNON_AUTH_MODE=paired
SHANNON_AGENT_HOST_TOKEN=
# Optional cross-platform memory bridge. Keep all three values empty until the
# legacy platform runtime has its own revocable service token and exact owner
# bindings. Exact Discord guild coverage uses conversationIdPrefix in the form
# "discord:<guild-id>:" while ownerUserId remains exact. The caller never
# supplies the Shannon scope key.
SHANNON_PLATFORM_BRIDGE_TOKEN=
SHANNON_PLATFORM_BRIDGE_SCOPE_KEY=owner
# Example shape only; use real opaque IDs solely in the ignored production env:
# [{"platform":"discord","conversationIdPrefix":"discord:...:","ownerUserId":"...","title":"Discord・コミュニティ"}]
# Audience defaults to shared: no private app memories or interests leave the app.
# Only a verified one-to-one conversation may opt in with "audience":"owner-private".
# This requires exact conversationId, never a guild prefix; author identity alone
# does not establish that everyone in a conversation is allowed to read private data.
SHANNON_PLATFORM_BRIDGE_BINDINGS_JSON=
# POST /v1/platform/reply (docs/platform-people-contract.md, Replies): the platform runtime asks her conversation kernel for
# the reply instead of its own model. One model call per new message; empty or "off" answers 503. A restart applies it.
# WARNING: with "on", SHANNON_PLATFORM_BRIDGE_TOKEN can write as the owner in an owner-private conversation (his memory,
# her tools, his feeling): it becomes an owner credential. Keep it only in the runtime and rotate it if it may have leaked.
SHANNON_PLATFORM_REPLY=off
# Her Minecraft body (docs/minecraft-body-contract.md): empty keeps it off (the turn route answers 503 and game events are
# ignored). Example shape only: {"deviceId":"<paired device id>","servers":[{"serverId":"...","ownerUuid":"<owner's account UUID>",
# "title":"...","onlineMode":true}]}. Only an online-mode server can bind the owner or remember anyone; a restart applies it.
SHANNON_MINECRAFT_BODY_JSON=
# Chat sentence stream (docs/chat-stream-contract.md): with "on", a `stream: "sentences"` turn the owner alone reads is
# sent while the model writes. "off" sends every turn only after it is complete and checked; a restart applies it.
SHANNON_CHAT_STREAM_EARLY=on
# The strength of a text reply's feeling (docs/architecture.md, "Emotion, face, and traits"): with "on", the chat model says in the
# structured reply it already returns what she feels in that reply and how strongly (subtle / moderate / strong), so a text
# conversation can leave a feeling that lingers for days, as a voice turn can. "off" offers no field and derives the feeling
# from her own words as before; a restart applies it.
SHANNON_CHAT_FEELING_STRENGTH=on
# Shannon's body (docs/body-contract.md): the Live2D desktop app reports touches and reads what to show.
# "off" refuses POST /v1/body/events and keeps stored events out of conversation turns; a restart applies it.
SHANNON_BODY_INGEST=on
# One look at the room through the body's camera (docs/body-contract.md, "Looking at the room"). Only in a text or voice turn with the
# owner alone, one JPEG frame, shown to the conversation model once and never stored. "off": never offered, never asked, answers refused.
SHANNON_BODY_LOOK=on
SHANNON_BODY_LOOK_PER_HOUR=6
# No count a day (owner decision 2026-10-03): empty or "unlimited". A number sets one; the hour's limit above stays the guard.
SHANNON_BODY_LOOK_PER_DAY=unlimited
# How recent the camera device's presence read must be for a look in conversation (10..300 seconds).
SHANNON_BODY_LOOK_PRESENCE_FRESH_SECONDS=75
# Looks from voice turns. "off" leaves text turns and her own time as they are. The threshold is how sure the
# voice router must be before she looks without being asked in so many words.
SHANNON_VOICE_ROOM_LOOK=on
SHANNON_VOICE_ROOM_LOOK_THRESHOLD=0.85
# When she stays silent in an owner call (docs/architecture.md, "When she does not answer"). "off" restores the decision
# from before these rules; a comma-separated list (not_addressed,backchannel,unfinished,hold,echo) keeps only those. A restart applies it.
SHANNON_VOICE_SILENCE_RULES=on
# A short utterance the router could not trust (reliability below the second value) is waited out up to this many characters (0 switches it off).
SHANNON_VOICE_FRAGMENT_CHARACTERS=16
SHANNON_VOICE_FRAGMENT_RELIABILITY=0.5
# Below this reply-required probability the router's doubt alone is silence (0 switches it off).
SHANNON_VOICE_REPLY_SILENCE_BELOW=0.15
# Rescue of an unanswered turn right after his request (solution-wanted probability; 0.7 otherwise).
# SHANNON_VOICE_RESCUE_AFTER_REQUEST=0.6
# Transcript trust: to act (0.85) and to talk, look and run the FCA turn (0.6).
# SHANNON_VOICE_TRANSCRIPT_RELIABILITY_THRESHOLD=0.85
# SHANNON_VOICE_TRANSCRIPT_CONVERSE_THRESHOLD=0.6
# Voice replay after a long silence (hours; 0 or off: as before), the gap marker, and the voice rerank cap.
# SHANNON_VOICE_REPLAY_GAP_HOURS=12
# SHANNON_VOICE_REPLAY_MARK_HOURS=3
# SHANNON_VOICE_RERANK_TIMEOUT_MS=1200
# When she is touched (docs/body-contract.md, "When she is touched"): a touch moves her feeling, becomes a memory, and she may
# answer it with one line (POST /v1/body/reactions, one small call of the conversation model, recorded in the chat lane).
# "off": the route answers 403 and a touch moves no feeling and leaves no memory; events are stored as before. A restart applies it.
SHANNON_BODY_REACTIONS=on
# How long the body keeps its microphone open for his answer to her line (0-30 seconds), and when the server gives up
# waiting for the model and answers "quiet" (200-4000 ms; the body waits 4.5 seconds).
SHANNON_BODY_REACTION_LISTEN_SECONDS=6
SHANNON_BODY_REACTION_DEADLINE_MS=3800
# Her emotional clock (docs/architecture.md, "Emotional continuity on her awake clock"). "awake": feelings fade only while she is
# awake and are kept while she is dormant. "wall" is the kill switch: the timing as it was, nothing kept or shown underneath.
# All services read this file, so the API, the workers and the activity loop agree. A restart applies it.
SHANNON_EMOTION_CLOCK=awake
# The owner's upcoming calendar (docs/calendar-contract.md): the apps send a bounded snapshot; the server reads no calendar service.
# "off" refuses PUT /v1/calendar/upcoming and keeps stored snapshots out of every prompt; a restart applies it.
# Set it for the API and the autonomy service alike.
SHANNON_CALENDAR_INGEST=on
# Private listening (docs/private-listening-contract.md): the owner's apps report whether only he can hear them now
# (registered earphones or wired headphones). "off" refuses POST /v1/private-listening and nobody counts as privately
# listening; a restart applies it.
SHANNON_PRIVATE_LISTENING=on
# A message she starts on her own, said through the owner's earphones by the app that is privately listening, instead of
# by her body. "off" keeps the state above and stops the speaking: no app is given a message, and her body is told about
# every message as before. The owner's own switch in each app is off until he turns it on.
SHANNON_PRIVATE_LISTENING_REACH_OUTS=on
# How long the app keeps its microphone open for his answer after speaking (0-30 seconds; 0: speak and do not listen).
SHANNON_PRIVATE_LISTENING_LISTEN_SECONDS=8
# A call from Shannon (docs/incoming-call-contract.md): phoning the owner's iPhone is a step of her own activity that she
# chooses (a VoIP push; the app shows an incoming call). Nothing rings by itself. It needs the three SHANNON_APNS_* values
# below (key id, team id, key file) and the owner's own switch in the iPhone app, which is off until he turns it on.
# "off" is the kill switch: she is not offered the step and nothing is rung; a restart applies it.
# SHANNON_PRIVATE_LISTENING_REACH_OUTS=off switches it off too. Set them for the API and the autonomy service alike.
SHANNON_INCOMING_CALLS=on
# The shortest time between two calls of hers, whatever became of the first (0-1440 minutes). There is no count of calls a
# day: the daily budget bounds them. She never calls while a conversation is in progress or while a call rings.
SHANNON_INCOMING_CALL_MIN_INTERVAL_MINUTES=5
# Operations console (docs/ops-contract.md): the legacy runtime reports its status with the platform bridge token.
# "off" refuses POST /v1/platform/ops/snapshot and makes GET /v1/ops answer "snapshot": null; a restart applies it.
SHANNON_PLATFORM_OPS_INGEST=on
# Commands from the desktop to the legacy runtime (start/stop a service or a Minecraft server, run a schedule now).
# Off by default: switch it on only when the legacy runtime is deployed with its claimer. "off": POST /v1/ops/commands
# answers 403, a claim answers null, and GET /v1/ops says "commandsSupported": false; a restart applies it.
SHANNON_PLATFORM_OPS_COMMANDS=off
SHANNON_DATABASE_PATH=/home/azureuser/shannon-ios-data/shannon.sqlite
SHANNON_AETHER_CONTEXT_FILE=/home/azureuser/.local/share/aether/shannon-context.json
SHANNON_AETHER_PROPOSAL_DIR=/home/azureuser/.local/share/aether/proposals
# Notion, read-only. The secret of an internal integration with "Read content" only; empty = not connected.
# Shannon never writes to Notion. Keep the real value only in the ignored env file.
SHANNON_NOTION_TOKEN=
# Optional: comma-separated page or database ids. Only these subtrees are readable.
SHANNON_NOTION_ROOT_PAGE_IDS=
# Phase 1: leave all three empty until a dedicated Voyager destination is issued.
# Partial configuration fails closed; never reuse an iPhone/device credential here.
SHANNON_VOYAGER_INTEGRATION_URL=
SHANNON_VOYAGER_INTEGRATION_TOKEN=
SHANNON_VOYAGER_WORKSPACE_ID=
# Optional read of open Voyager tasks that have a due date, for the owner's upcoming items. The search contract has no due date,
# so leave this empty until Voyager offers such a read (GET ?workspaceId&dueFrom&dueBefore&limit, contract 1.1, items with dueAt).
SHANNON_VOYAGER_TASK_UPCOMING_URL=
# Optional; falls back to SHANNON_LLM_MODEL.
SHANNON_ORGANIZE_MODEL=
SHANNON_APNS_KEY_ID=
SHANNON_APNS_TEAM_ID=
SHANNON_APNS_BUNDLE_ID=com.r41r41.shannon
SHANNON_APNS_PRIVATE_KEY_FILE=/home/azureuser/.config/shannon-ios/AuthKey_Shannon.p8

# A look through the camera of the iPhone/Mac app a conversation turn came from (docs/body-contract.md, "A look through the app").
# On unless set to off. Separate from SHANNON_BODY_LOOK and SHANNON_VOICE_ROOM_LOOK, which are about her desktop body.
# SHANNON_APP_LOOK=off
# Loop guard: seconds between two looks in one scope (0-600, default 5).
# SHANNON_APP_LOOK_MIN_INTERVAL_SECONDS=5

# ADR-0008 stage 4 (SHANNON_ADR8_STAGE4, generated section below): required since Syzygy ADR-0009 S9, with the mind worker
# (shannon-ios-mind) running; the common task runtime is always on and the API stops at start without it.
# Default: the database directory / mind-runtime / mind.sock (owner-only Unix socket).
# SHANNON_MIND_SOCKET=/home/azureuser/shannon-ios-data/mind-runtime/mind.sock

# --- Switches: generated by scripts/generate-env-example.mjs from packages/switches/src/table.ts; edit the table. ---
# ADR-0008 stage 1 master switch: the prediction and choice ledgers, the value table and decision traces. [learning; on unless off/false/0/disabled/no/none]
SHANNON_ADR8_STAGE1=on
# ADR-0006 stage 1 prediction shadow; the prediction ledger needs it. [learning; on unless off/false/0/disabled/no/none]
SHANNON_PREDICTION_SHADOW=on
# Predictions opened before an outcome and settled against it. [learning; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE1, SHANNON_PREDICTION_SHADOW.
SHANNON_PREDICTION_LEDGER=on
# Her choices, their reward and the value table. [learning; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE1.
SHANNON_CHOICE_LEDGER=on
# A settled choice moves her mood (choice-appraised). [learning; on unless off/false/0/disabled/no/none] Needs SHANNON_CHOICE_LEDGER.
SHANNON_REWARD_MOOD=on
# The value-table lines in her thinking prompt. [learning; on unless off/false/0/disabled/no/none] Needs SHANNON_CHOICE_LEDGER.
SHANNON_VALUE_FACTS=on
# One content-free trace per decision. [learning; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE1.
SHANNON_DECISION_TRACES=on
# ADR-0008 stage 2 master switch: tool menu, read tools, difficulty, verifier, skills, tree recall. [routing; on unless off/false/0/disabled/no/none]
SHANNON_ADR8_STAGE2=on
# Jev chooses the tool schemas a turn is offered. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_TOOL_MENU=on
# Notion, Voyager tasks, the schedule and place search as gated registry tools. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_READ_TOOLS=on
# Difficulty questions, the tier policy and the competence table. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_DIFFICULTY=on
# The turn verifier (write claims against write results). [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_TURN_VERIFY=on
# Skill memory. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_SKILLS=on
# Readable copies of her skills in her Aether folder. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_SKILLS.
SHANNON_SKILL_EXPORT=on
# Beam search over headings for recall. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2.
SHANNON_TREE_RECALL=on
# The sonnet tier may leave for Anthropic (also needs the Anthropic key). [routing; off unless on/true/1/yes] Needs SHANNON_DIFFICULTY.
SHANNON_SONNET_ROUTING=off
# Conversation tool calls and tier choices go into reward, mood and the value table. [routing; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE2, SHANNON_CHOICE_LEDGER.
SHANNON_CONVERSATION_REWARD=on
# ADR-0008 stage 3 master switch: perception, attention, the workspace and the memory writer. [mind; on unless off/false/0/disabled/no/none]
SHANNON_ADR8_STAGE3=on
# Every surface hands what it perceived to the mind as one event. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_MIND_EVENTS=on
# Salience orders the events. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_MIND_EVENTS.
SHANNON_ATTENTION=on
# The shared place and the notices of a turn prompt. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ATTENTION.
SHANNON_WORKSPACE=on
# Untrusted text reaches a prompt inside data frames. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_DATA_FRAMES=on
# Intent repeat, intent expiry and topic reuse checks on her own messages. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_PROACTIVE_GATE=on
# Memory proposals go to the outbox and one writer applies them. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_MEMORY_OUTBOX=on
# People facts carry validity times. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_MEMORY_OUTBOX.
SHANNON_TEMPORAL_FACTS=on
# Two-clock evidence decay replaces the fading of impressions. [mind; off unless on/true/1/yes] Needs SHANNON_ADR8_STAGE3.
SHANNON_EVIDENCE_DECAY=off
# Identity tiers suggest a merge; the owner merges. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_IDENTITY_TIERS=on
# The trust ledger records its closed kinds. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_TRUST_LEDGER=on
# The replay summary is a template rendered by code. [mind; on unless off/false/0/disabled/no/none] Needs SHANNON_ADR8_STAGE3.
SHANNON_STRUCTURED_COMPACTION=on
# ADR-0008 stage 4 action threads in the mind worker. Required: the common task runtime is always on (ADR-0009 S9), so the API stops at start without it (FCA_ACTION_THREADS_REQUIRED); run the mind worker (worker:mind) beside the API. [actions; off unless on/true/1/yes] Needs SHANNON_WORKSPACE.
SHANNON_ADR8_STAGE4=on
# ADR-0008 stage 5 ports: self interests, task trees, reply-bound feedback, gated self revision. [tasks; off unless on]
SHANNON_ADR8_STAGE5=off
# Touch reflexes run under the FCA runtime. [fca; off unless on] Needs SHANNON_ADR8_STAGE4.
SHANNON_FCA_TOUCH=off
# Registered Minecraft start and stop tools under the action gate. [minecraft; off unless on] Needs SHANNON_ADR8_STAGE4.
SHANNON_MINECRAFT_LIFECYCLE=off
# Conversation recall reads temporal knowledge. [recall; off unless on]
SHANNON_TEMPORAL_KNOWLEDGE_RECALL=off
# Only a 400 naming the offered tools or schemas earns the tool-less answer (off: any non-auth 4xx does, as before). [model; off unless on/true/1/yes]
SHANNON_ANTHROPIC_STRICT_REJECTIONS=off
# Foreground text turns of Claude 5.5 keep one cached prefix (fixed tools, schema and system; per-turn lines after the words). [model; off unless on/true/1/yes]
SHANNON_CLAUDE_CACHE_PLAN=off
# Claude 5.5 voice turns keep the same cached prefix (fixed tools and system; per-turn lines after the words), canaried apart from text. [model; off unless on/true/1/yes]
SHANNON_CLAUDE_CACHE_PLAN_VOICE=off
# Claude 5.5 conversation tools go strict within the grammar budget (off: native non-strict tools; a new strict tool set cost 5-8 s to compile). [model; off unless on/true/1/yes]
SHANNON_STRICT_CONVERSATION_TOOLS=off
# Haiku voice turns think adaptively before speaking (off: thinking disabled, owner-approved 2026-10-13; it cost 2-3 s before the first word). [model; off unless on/true/1/yes]
SHANNON_HAIKU_VOICE_THINKING=off
# Light or read-aloud text turns answer without thinking unless hard or research (owner 2026-10-14; off: text always thinks). [model; on unless off/false/0/disabled/no/none]
SHANNON_TEXT_LIGHT_NO_THINKING=on
# Replayed history is rendered once per epoch and only appended to until its budget is passed (text; voice also needs the voice plan). [model; off unless on/true/1/yes] Needs SHANNON_CLAUDE_CACHE_PLAN.
SHANNON_REPLAY_EPOCHS=off
# Voice replays the last 4-8 exchanges after a summary of the call before them, frozen per epoch (owner 2026-10-14; off: the budget window). [model; on unless off/false/0/disabled/no/none] Needs SHANNON_REPLAY_EPOCHS, SHANNON_CLAUDE_CACHE_PLAN_VOICE.
SHANNON_VOICE_HISTORY_SUMMARY=on
# Morning brief (home weather, today's schedule, headlines) as the day's initiative, 07-10 owner time; needs SHANNON_OWNER_HOME_LOCATION. [outreach; off unless on/true/1/yes]
SHANNON_MORNING_BRIEF=off
# ADR-0012 stage 1: her inner note (reflection after salient events), character core and prompt cleanup; off, every prompt is as it was. [emotion; off unless on/true/1/yes]
SHANNON_INNER_NOTE=off
# ADR-0013 stage 1: every touch, word and reply of hers is a feeling event; the day's episode ledger; wordless touches. Off: as it was. [emotion; off unless on/true/1/yes]
SHANNON_FEELING_EVENTS=off
# ADR-0013 stage 1: one face function (faceFor) for replies, touches and presence; her own apology words no longer take the face. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_SINGLE_FACE=off
# ADR-0013 stage 1: Jev picks her stance, strength and comeback drawer before she replies; the last, strongest block of the prompt. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_FEELING_TURN=off
# Owner 2026-10-14: a strong feeling turn's text reply goes to Sonnet (capped a day by SHANNON_FEELING_STRONG_REPLY_DAILY_CAP); else Haiku. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_TURN.
SHANNON_FEELING_STRONG_REPLY_MODEL=off
# ADR-0013 stage 2 shadow: appraisal, core affect, blame and composure folded from her events and recorded beside the current state; no behaviour. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_CORE_AFFECT=off
# ADR-0013 stage 2: her reply is checked (giving in, lecture, AI tone…); strong, order and public text turns before sending, one rewrite. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_TURN.
SHANNON_REPLY_CHECK=off
# ADR-0013 D7: in a strong scene (fast layer past her band, or blame), Haiku writes her feeling in 2-3 lines before a text reply; owner alone. [emotion; off unless on/true/1/yes] Needs SHANNON_CORE_AFFECT, SHANNON_FEELING_TURN.
SHANNON_FEELING_SENTENCE=off
# ADR-0013 D3.1: the feeling turn's Jev call also asks whether his words were meant or teasing (feeling_meaning.v1, voice_route.v5). [emotion; off unless on/true/1/yes] Needs SHANNON_CORE_AFFECT, SHANNON_FEELING_TURN.
SHANNON_FEELING_MEANING=off
# ADR-0013 stage 3: trust, liking, respect and irritation per person, moved nightly from her closed days (drops fast, recovers slowly, floor). [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_RELATIONSHIP_LEDGER=off
# ADR-0013 stage 3: a closed day's incidents become episodes she recalls later (yesterday's, older ones when their subject comes up). [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_EPISODE_MEMORY=off
# ADR-0013 stage 3: her boundaries with their basis and origin (self or told); a told one is hers only once she endorses it in reflection. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS.
SHANNON_BOUNDARY_MEMORY=off
# ADR-0013 stage 4: events keyed by who wrote (account, never name), friend and light ledgers, audience layers, source cap, audience checks. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_EVENTS, SHANNON_REPLY_CHECK.
SHANNON_FEELING_AUDIENCE=off
# ADR-0013 item 10 (owner: B): text reply form (length, emoji, endings) and pacing (typing, split in two, sulk pause ≤20 s) from her feeling. [emotion; off unless on/true/1/yes] Needs SHANNON_FEELING_TURN.
SHANNON_TEXT_REGISTER=off
# ADR-0013 §6: her inner note reads the fast layer and the ledger as narrator (honne not from her replies); intent and until unchanged. [emotion; off unless on/true/1/yes] Needs SHANNON_CORE_AFFECT, SHANNON_INNER_NOTE.
SHANNON_INNER_NARRATOR=off
# Reminders, timers, calendar events and Apple Music done by the owner's own app through the device-action outbox. [device; on unless off/false/0/disabled/no/none]
SHANNON_DEVICE_ACTIONS=on
# Her own-time activity loop (also needs its own model credential and an unpaused owner switch). [autonomy; off unless true]
SHANNON_AUTONOMY_ENABLED=false
# Owner 2026-10-14: moments she perceives (he came back, a long quiet, morning, late night, a story waiting) may lead her to speak in her own words. [autonomy; on unless off/false/0/disabled/no/none] Needs SHANNON_AUTONOMY_ENABLED, SHANNON_PROACTIVE_GATE.
SHANNON_PROACTIVE_MOMENTS=on
# Owner 2026-10-14 (form): she decides herself whether to speak at a moment (core, inner note, her day, recent talk); off, the Jev judge. [autonomy; on unless off/false/0/disabled/no/none] Needs SHANNON_PROACTIVE_MOMENTS.
SHANNON_PROACTIVE_SELF=on
# A due promise is told at its time, apart from the day's topic slot and the 90-minute topic cooldown, in her words; off, as before. [outreach; on unless off/false/0/disabled/no/none]
SHANNON_PROMISE_ON_TIME=on
# Owner 2026-10-14: off, telling him a piece writes no fixed line (the piece is readable; a story waiting is a moment of hers). [autonomy; off unless on/true/1/yes]
SHANNON_STUDY_SHOWING_LINE=off
# A body is handed an initiative to say aloud only while it is fresh (morning brief in its hours; topics within the gate's intent expiry). [outreach; on unless off/false/0/disabled/no/none]
SHANNON_BODY_INITIATIVE_FRESHNESS=on
# ADR-0009 stage 2: the Executive decides her own time (one deliberation, one capability); off, the old own-time loop thinks. [autonomy; off unless on/true/1/yes] Needs SHANNON_AUTONOMY_ENABLED.
SHANNON_EXECUTIVE=off
# Owner 2026-10-14: a VM operator may ask, over a service-user socket, for Minecraft lifecycle or one request (operator-minecraft-contract). [minecraft; off unless on/true/1/yes]
SHANNON_OPERATOR_MINECRAFT=off
# --- End of the generated switches. ---

# Install as /home/azureuser/.config/shannon-ios/api.env with mode 0600.
# Never place the real file inside the repository.
OPENAI_API_KEY=
SHANNON_LLM_MODEL=gpt-5.6-luna
# Optional TypeSafe Jev voice router. Keep the real key only in this mode-0600 file.
# Until waitlist access is granted, the lightweight OpenAI router is selected.
TYPESAFE_API_KEY=
SHANNON_JEV_MODEL=jev-latest
SHANNON_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
SHANNON_JEV_TIMEOUT_MS=900
SHANNON_VOICE_ROUTER_MODEL=gpt-5.6-luna
SHANNON_VOICE_ROUTER_TIMEOUT_MS=1200
SHANNON_VOICE_SKILL_THRESHOLD=0.55
# Leave unset until Shannon Cloud is online and verified. Then use shannon-cloud.
SHANNON_AGENT_DEFAULT_HOST=shannon-mac
SHANNON_SLEEP_MODEL=gpt-5.6-luna
SHANNON_BACKGROUND_LLM_MONTHLY_BUDGET_USD=0.5
# Bounded autonomy (Syzygy ADR-0002). Off until the owner enables the activity loop.
# These values are core: Shannon cannot change them through the autonomy service.
SHANNON_AUTONOMY_ENABLED=false
# Hard daily cap for her own model/API use, per owner-local day, and the conversion used to count it.
SHANNON_AUTONOMY_DAILY_BUDGET_YEN=1000
SHANNON_AUTONOMY_YEN_PER_USD=160
SHANNON_AUTONOMY_TIMEZONE=Asia/Tokyo
# Largest increase the owner can approve for one day.
SHANNON_AUTONOMY_MAX_EXTRA_YEN=3000
SHANNON_AUTONOMY_MAX_PUBLIC_READS=200
# Reads of the owner's shared Notion pages by her own activity, per owner-local day.
SHANNON_AUTONOMY_MAX_NOTION_READS=100
# Activity loop (ADR-0002 step 3): `shannon-ios-autonomy.service`. It stays idle unless SHANNON_AUTONOMY_ENABLED=true,
# the owner has not paused her in the app, and a dedicated credential below is set.
# Dedicated keys for her own activity, each with a spending cap set at the provider. Never reuse OPENAI_API_KEY or
# GEMINI_API_KEY here: a value equal to the conversation key is treated as not configured. A Gemini key alone is enough.
SHANNON_AUTONOMY_GEMINI_API_KEY=
SHANNON_AUTONOMY_OPENAI_API_KEY=
# Cadence: cycles per owner-local day, minutes between cycle starts (default: 24 h / cycles), steps and reads per cycle.
SHANNON_AUTONOMY_CYCLES_PER_DAY=4
SHANNON_AUTONOMY_CYCLE_INTERVAL_MINUTES=
SHANNON_AUTONOMY_CYCLE_MAX_STEPS=6
SHANNON_AUTONOMY_CYCLE_MAX_READS=2
# A cycle does not start while the owner wrote or spoke this recently.
SHANNON_AUTONOMY_OWNER_ACTIVE_MINUTES=10
SHANNON_AUTONOMY_POLL_SECONDS=60
# Public reading: bytes and milliseconds per page. The per-day count is SHANNON_AUTONOMY_MAX_PUBLIC_READS above.
SHANNON_AUTONOMY_READ_MAX_BYTES=1500000
SHANNON_AUTONOMY_READ_TIMEOUT_MS=10000
# Places to start reading from, e.g. [{"title":"<name>","url":"https://<public page>"}]. Empty uses the built-in list.
SHANNON_AUTONOMY_READING_SEEDS_JSON=
# What she asks for when the day's cap stops a step she cares about (once a day; the owner decides).
SHANNON_AUTONOMY_BUDGET_REQUEST_YEN=300
# USD per million tokens for models whose price is not in the code, e.g. {"gemini-3.8-flash":{"input":<usd>,"output":<usd>}}.
# Unset models are charged at a deliberately high fail-safe rate.
SHANNON_AUTONOMY_MODEL_PRICES_JSON=
# Her places. The workspace must be apart from the deployed source.
SHANNON_AUTONOMY_WORKSPACE_ROOT=
# Her folder on the owner's machines (docs/host-folder-contract.md), e.g. {"owner-windows":{"deviceId":"<16 hex id of the paired device>"}}.
# Only that device may claim work for the host. The earlier shape {"<host>":"<absolute folder>"} is still read. Empty registers no host.
SHANNON_AUTONOMY_HOST_FOLDERS_JSON=
# Copies she may queue for her folders per owner-local day (0 switches the step off), and how long a device may hold one.
SHANNON_AUTONOMY_MAX_HOST_FOLDER_WRITES=10
SHANNON_AUTONOMY_HOST_STEP_LEASE_SECONDS=300
# Extra roots, separated by the platform path delimiter. The running source and the database directory are always protected.
SHANNON_AUTONOMY_REPOSITORY_ROOTS=
SHANNON_AUTONOMY_PRODUCTION_ROOTS=
SHANNON_AUTONOMY_PROTECTED_PATHS=
# Memory V2 semantic recall (OpenAI; response-path lane `memory`, background lane `memory_background`)
SHANNON_MEMORY_SEMANTIC_ENABLED=true
SHANNON_MEMORY_MAX_MODEL_CALLS_PER_TURN=4
SHANNON_MEMORY_SEMANTIC_TIMEOUT_MS=4000
SHANNON_MEMORY_SEMANTIC_SCAN_LIMIT=5000
SHANNON_MEMORY_MODEL=gpt-5.6-luna
SHANNON_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
SHANNON_MEMORY_EMBEDDING_DIMENSIONS=512
SHANNON_MEMORY_EMBEDDING_INTERVAL_MS=30000
# Shannon private knowledge building after each sleep batch (background budget)
SHANNON_KNOWLEDGE_ENABLED=true
SHANNON_KNOWLEDGE_MODEL=gpt-5.6-terra
SHANNON_VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
SHANNON_VOICE_USD_PER_MINUTE=0.0045
SHANNON_VOICE_DAILY_BUDGET_USD=0.10
# Voice calls transcribe through OpenAI Realtime. Azure mints a short-lived client
# secret from OPENAI_API_KEY; the permanent key is never returned to an Apple client.
# Optional overrides (defaults shown). The per-minute estimate is not provider-verified.
# SHANNON_VOICE_CALL_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# SHANNON_VOICE_CALL_SILENCE_MS=360
# SHANNON_VOICE_CALL_SECRET_SECONDS=300
# SHANNON_VOICE_CALL_USD_PER_MINUTE=0.003
# Gemini now supplies only response speech (TTS). The key stays on Azure and is never
# returned to an Apple client. Flash-Lite pricing below is valid through
# 2026-12-31; update the estimate when provider pricing changes.
GEMINI_API_KEY=
SHANNON_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
SHANNON_GEMINI_TTS_VOICE=Leda
SHANNON_GEMINI_TTS_STYLE=warm, naturally cute, intimate, and conversational Japanese without sounding childish or theatrical
SHANNON_GEMINI_TTS_TIMEOUT_MS=60000
SHANNON_GEMINI_TTS_OUTPUT_USD_PER_10_SECONDS=0.0015
# One-use transcription tokens are minted here; the permanent key is never sent to iPhone.
SHANNON_GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
SHANNON_GEMINI_LIVE_SESSION_MINUTES=20
SHANNON_GEMINI_LIVE_INPUT_USD_PER_MINUTE=0.005
SHANNON_GEMINI_LIVE_OUTPUT_USD_PER_MINUTE=0.018
# One explicit camera snapshot at a time; images are sent with store=false.
SHANNON_VISION_MODEL=gpt-5.6-luna
SHANNON_VISION_TIMEOUT_MS=30000
SHANNON_AUTH_PEPPER=
SHANNON_OWNER_SCOPE_KEY=owner
SHANNON_AUTH_MODE=paired
SHANNON_AGENT_HOST_TOKEN=
# Optional cross-platform memory bridge. Keep all three values empty until the
# legacy platform runtime has its own revocable service token and exact owner
# bindings. Exact Discord guild coverage uses conversationIdPrefix in the form
# "discord:<guild-id>:" while ownerUserId remains exact. The caller never
# supplies the Shannon scope key.
SHANNON_PLATFORM_BRIDGE_TOKEN=
SHANNON_PLATFORM_BRIDGE_SCOPE_KEY=owner
# Example shape only; use real opaque IDs solely in the ignored production env:
# [{"platform":"discord","conversationIdPrefix":"discord:...:","ownerUserId":"...","title":"Discord・コミュニティ"}]
# Audience defaults to shared: no private app memories or interests leave the app.
# Only a verified one-to-one conversation may opt in with "audience":"owner-private".
# This requires exact conversationId, never a guild prefix; author identity alone
# does not establish that everyone in a conversation is allowed to read private data.
SHANNON_PLATFORM_BRIDGE_BINDINGS_JSON=
# Chat sentence stream (docs/chat-stream-contract.md): with "on", a `stream: "sentences"` turn the owner alone reads is
# sent while the model writes. "off" sends every turn only after it is complete and checked; a restart applies it.
SHANNON_CHAT_STREAM_EARLY=on
# Shannon's body (docs/body-contract.md): the Live2D desktop app reports touches and reads what to show.
# "off" refuses POST /v1/body/events and keeps stored events out of conversation turns; a restart applies it.
SHANNON_BODY_INGEST=on
# Operations console (docs/ops-contract.md): the legacy runtime reports its status with the platform bridge token.
# "off" refuses POST /v1/platform/ops/snapshot and makes GET /v1/ops answer "snapshot": null; a restart applies it.
SHANNON_PLATFORM_OPS_INGEST=on
SHANNON_DATABASE_PATH=/home/azureuser/shannon-ios-data/shannon.sqlite
SHANNON_AETHER_CONTEXT_FILE=/home/azureuser/.local/share/aether/shannon-context.json
SHANNON_AETHER_PROPOSAL_DIR=/home/azureuser/.local/share/aether/proposals
# Notion, read-only. The secret of an internal integration with "Read content" only; empty = not connected.
# Shannon never writes to Notion. Keep the real value only in the ignored env file.
SHANNON_NOTION_TOKEN=
# Optional: comma-separated page or database ids. Only these subtrees are readable.
SHANNON_NOTION_ROOT_PAGE_IDS=
# Phase 1: leave all three empty until a dedicated Voyager destination is issued.
# Partial configuration fails closed; never reuse an iPhone/device credential here.
SHANNON_VOYAGER_INTEGRATION_URL=
SHANNON_VOYAGER_INTEGRATION_TOKEN=
SHANNON_VOYAGER_WORKSPACE_ID=
# Optional; falls back to SHANNON_LLM_MODEL.
SHANNON_ORGANIZE_MODEL=
SHANNON_APNS_KEY_ID=
SHANNON_APNS_TEAM_ID=
SHANNON_APNS_BUNDLE_ID=com.r41r41.shannon
SHANNON_APNS_PRIVATE_KEY_FILE=/home/azureuser/.config/shannon-ios/AuthKey_Shannon.p8

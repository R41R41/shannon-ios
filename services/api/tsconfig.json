{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/api.tsbuildinfo",
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "evals/**/*.ts"]
}


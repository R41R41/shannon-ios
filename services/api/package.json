{
  "name": "@shannon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:llm-memory": "tsx --env-file-if-exists=../../.env tests/explicitMemoryLiveEval.ts",
    "test:llm-agent-task": "tsx --env-file-if-exists=../../.env tests/agentTaskProposalLiveEval.ts",
    "test:llm-daily-mind": "tsx --env-file-if-exists=../../.env tests/dailyMindLiveEval.ts",
    "test:llm-voice-router": "tsx --env-file-if-exists=../../.env tests/voiceDecisionLiveEval.ts",
    "test:llm-memory-recall": "tsx --env-file-if-exists=../../.env tests/memoryRecallLiveEval.ts",
    "dev": "tsx --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "worker:world": "tsx --env-file-if-exists=../../.env src/worldWorker.ts",
    "worker:autonomy": "tsx --env-file-if-exists=../../.env src/autonomyWorker.ts",
    "agent:fake": "tsx --env-file-if-exists=../../.env src/fakeAgentHost.ts",
    "agent:host": "tsx --env-file-if-exists=../../.env src/agentHost.ts",
    "testflight:distribute": "tsx --env-file-if-exists=../../.env src/testflightDistributor.ts",
    "auth": "tsx --env-file-if-exists=../../.env src/authCli.ts",
    "migrate:study-to-aether": "tsx --env-file-if-exists=../../.env scripts/migrate-study-to-aether.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@shannon/cognition": "workspace:*",
    "@shannon/learning": "workspace:*",
    "@shannon/mind": "workspace:*"
  }
}
